    --card-bg1:    rgba(58, 81, 100, 0.05);
    --stroke1:     rgba(58, 81, 100, 0.16);
  }
  .webcast-section {
    position: relative;
    background: transparent;  
    padding: 20px 0;
  }
  .webcast-copy {
    color: var(--text1);

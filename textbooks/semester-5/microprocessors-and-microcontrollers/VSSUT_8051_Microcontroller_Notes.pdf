  }

  .webcast-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    margin-bottom: 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--p700);
    background: rgba(138, 205, 242, 0.18);
    border: 1px solid rgba(58, 81, 100, 0.22);
    border-radius: 999px;
  }
  .webcast-eyebrow i { font-size: 13px; color: var(--a700); }

  .webcast-title {
    margin: 0 0 18px;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -.01em;
    color: var(--p700);
  }
  .webcast-title .accent { color: var(--a700); }

  .webcast-text {
    margin: 0 0 26px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted1);
  }

  .webcast-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }
  .webcast-meta li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    font-size: .875rem;
    font-weight: 600;
    color: var(--p700);
    background: var(--card-bg1);
    border: 1px solid var(--stroke1);
    border-radius: 12px;
    transition: transform .25s ease, border-color .25s ease, background .25s ease;
  }
  .webcast-meta li:hover {
    transform: translateY(-2px);
    border-color: rgba(58, 81, 100, 0.38);
    background: rgba(138, 205, 242, 0.20);
  }
  .webcast-meta i { color: var(--a700); font-size: .95rem; }
  .webcast-link-note {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(138, 205, 242, 0.12);
    border: 1px dashed rgba(58, 81, 100, 0.28);
    border-left: 3px solid var(--p700);
  }
  .webcast-link-note i {
    color: var(--a700);
    font-size: 1.15rem;
    margin-top: 2px;
    flex-shrink: 0;
  }
  .webcast-link-note p {
    margin: 0;
    font-size: .9rem;
    line-height: 1.6;
    color: var(--text-muted1);
  }
  .webcast-link-note strong { color: var(--p700); }
  .webcast-media {
    position: relative;
    animation: fadeUp .8s .15s ease both;
  }

  .video-frame {
    position: relative;
    padding: 14px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--stroke1);
    box-shadow: 0 24px 50px -24px rgba(58, 81, 100, 0.38);
    backdrop-filter: blur(10px);
  }
  .video-title-wrap {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 6px 6px 16px;
  }
  .video-title-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(138, 205, 242, 0.22);
    border: 1px solid rgba(58, 81, 100, 0.18);
    color: var(--a700);
    font-size: .95rem;
  }
  .video-title {
    margin: 0;
    font-size: .98rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--p700);
  }
  .video-title span {
    display: block;
    margin-top: 4px;
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--a700);
  }

  .video-ratio {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #1e2c38;
  }
  .video-ratio video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #1e2c38;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 767.98px) {
    .webcast-section { padding: 60px 0; }
    .webcast-media   { margin-top: 8px; }
    .video-title     { font-size: .92rem; }

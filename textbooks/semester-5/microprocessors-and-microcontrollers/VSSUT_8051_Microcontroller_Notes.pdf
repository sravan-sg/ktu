    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 9999;
    isolation: isolate;

    display: flex;
    align-items: center;
    gap: 12px;
    max-width: min(400px, calc(100vw - 28px));

    padding: 12px 18px 12px 12px;
    border-radius: 18px;
    background: #fff;            
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;

    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.3;

    box-shadow:
      0 18px 42px -14px rgba(15, 27, 45, .38),
      0 4px 12px -4px rgba(15, 27, 45, .12);

    transition: transform .2s ease, box-shadow .2s ease;
  }

  .zoho-float-link::before{
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;                       /* border thickness */
    border-radius: inherit;
    background: linear-gradient(120deg,
      var(--zoho-red), var(--zoho-amber), var(--zoho-green), var(--zoho-blue), var(--zoho-red));
    background-size: 300% 300%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    animation: zoho-gradient 4s linear infinite;
    pointer-events: none;
  }

  .zoho-float-link:hover{
    transform: translateY(-3px);
    box-shadow:
      0 24px 52px -16px rgba(15, 27, 45, .45),
      0 6px 16px -6px rgba(15, 27, 45, .16);
  }

  .zoho-float-link:focus-visible{
    outline: 3px solid rgba(34, 109, 180, .55);
    outline-offset: 4px;
  }

  /* ---- Logo image (properly sized) ---- */
  .zoho-logo{
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #fff;
  }

  .zoho-logo img{
    width: 100%;
    height: 100%;
    object-fit: contain;                
    display: block;
  }

  .zoho-text{
    display: flex;
    flex-direction: column;
  }

  .zoho-word{ font-weight: 800; }
  .zoho-word span:nth-child(1){ color: var(--zoho-red); }
  .zoho-word span:nth-child(2){ color: var(--zoho-amber); }
  .zoho-word span:nth-child(3){ color: var(--zoho-green); }
  .zoho-word span:nth-child(4){ color: var(--zoho-blue); }

  @keyframes zoho-gradient{
    0%   { background-position:   0% 50%; }
    100% { background-position: 300% 50%; }
  }

  @media (max-width: 480px){
    .zoho-float-link{
      right: 14px;
      bottom: 14px;
      padding: 10px 14px 10px 10px;
      gap: 10px;
      font-size: 13.5px;
      border-radius: 15px;
    }
    .zoho-logo{ width: 36px; height: 36px; border-radius: 8px; }
  }

  @media (prefers-reduced-motion: reduce){
    .zoho-float-link::before{ animation: none !important; }
    .zoho-float-link{ transition: none; }
  }
